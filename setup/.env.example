# Only needed if you build/run setup/ independently of the root
# docker-compose.yml (which already passes these through -- see its
# comments next to the "setup-wizard" service).

# Same UID:GID that owns your secrets.json -- must match the main
# findmy-map service's PUID/PGID exactly, since both read/write the same
# file. Find the current owner with: stat -c '%u:%g' /path/to/secrets.json
PUID=1000
PGID=1000

# How long (seconds) the setup token printed in the container logs stays
# redeemable after the container starts.
GFM_SETUP_TOKEN_TTL=900

# Hard ceiling (seconds) on one wizard run before its browser/X session is
# torn down. Generous enough to cover two sequential interactive Google
# logins (up to 300s each, see the design spec) plus setup overhead.
GFM_SETUP_RUN_TIMEOUT_SECONDS=900
