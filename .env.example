# Copy this file to `.env` and fill in the values for your host.
# `.env` is git-ignored -- never commit it.

# --- Required: paths on the Docker host -------------------------------------

# The shared secrets.json from your existing GoogleFindMyTools container's
# data volume. This single file is bind-mounted read-write into the
# container so login tokens stay in sync. Do NOT point this at the whole
# Auth/ directory -- only the one file. Don't have a GoogleFindMyTools
# instance to share this from? Point this at a new, empty path instead and
# generate it in-place with the setup wizard -- see README "Generating
# secrets.json with the setup wizard".
GFM_SECRETS_FILE=/path/to/googlefindmytools/Auth/secrets.json

# Directory on the host where this app keeps its SQLite database
# (history.db). Created if it does not exist.
GFM_DATA_DIR=./data

# UID:GID that owns the two paths above. The container starts as root and
# its entrypoint chowns GFM_DATA_DIR to match, then drops privileges and
# runs the app as this user. Find the secrets.json owner with:
#   stat -c '%u:%g' "$GFM_SECRETS_FILE"
PUID=1000
PGID=1000

# The external Docker network your authenticating reverse proxy is on.
# Create it once with:  docker network create proxy-net
PROXY_NETWORK=proxy-net

# --- Optional tuning ------------------------------------------------------

# Seconds between automatic location polls.
# GFM_POLL_INTERVAL_SECONDS=120

# Reverse-geocoding endpoint for the timeline's "visited places" list.
# Defaults to OSM's public Nominatim. Set to an empty value to disable
# geocoding (places are then labelled by coordinates). For anything beyond
# light personal use, point this at your own Nominatim/Photon instance.
# GFM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# GFM_GEOCODE_EMAIL=you@example.com

# What counts as a "visited place": stayed within this radius (metres) for
# at least this many minutes.
# GFM_VISIT_RADIUS_M=100
# GFM_VISIT_MIN_MINUTES=15

# Delete location fixes older than this many days. Empty (the default) keeps
# history forever -- an upgrade never starts silently deleting data an
# existing install never opted into losing. Checked at most once a day.
# GFM_HISTORY_RETENTION_DAYS=180

# Show the "location updates are failing" banner after this many poll cycles
# in a row have produced no data (poll raised, or every device errored --
# the shape an expired token takes). 0 disables the banner.
# GFM_POLL_ALERT_AFTER=3

# Pin a colour per device (JSON: canonic id OR display name -> hex/keyword).
# GFM_DEVICE_COLORS={"My phone":"#4e9bff","ESP32 tracker":"#f2545b"}

# Optional built-in login (configured on the settings page, off by
# default). Set to 1 to force it OFF regardless of the stored setting --
# use this to recover from a lost password, then reset it on the
# settings page.
# GFM_AUTH_DISABLE=1

# Fixed delay (milliseconds) added to every login attempt.
# GFM_LOGIN_DELAY_MS=500

# --- Optional: setup wizard (opt-in, see README "Generating secrets.json
# with the setup wizard") -----------------------------------------------

# Shows a "Setup Wizard" link on the settings page when set -- point it at
# wherever the "setup-wizard" compose service is actually reachable from
# your browser (its own reverse-proxy host, typically). Leave unset to
# hide the link entirely.
# GFM_SETUP_WIZARD_URL=

# How long (seconds) the setup token printed in the wizard container's logs
# stays redeemable after that container starts.
# GFM_SETUP_TOKEN_TTL=900

# Hard ceiling (seconds) on one wizard run before its browser/X session is
# torn down. Generous enough to cover two sequential interactive Google
# logins (up to 300s each) plus setup overhead.
# GFM_SETUP_RUN_TIMEOUT_SECONDS=900
